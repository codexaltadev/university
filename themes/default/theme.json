{
    "slug": "default",
    "name": "University Default",
    "version": "2.0.0",
    "requires_core": "^1.0",
    "author": { "name": "DIU Web Team", "email": "web@example.edu" },
    "license": "proprietary",
    "description": "The bundled website theme — the look of daffodilvarsity.edu.bd: glass header with utility links and mega menus, grid launcher, campus footer.",
    "screenshot": "screenshot.png",

    "layouts": {},

    "menu_locations": {
        "primary": "Primary (header)",
        "topbar": "Utility links (above the primary menu)",
        "footer-1": "Footer column 1",
        "footer-2": "Footer column 2",
        "footer-3": "Footer column 3",
        "footer-4": "Footer column 4",
        "quick-links": "Quick links",
        "quick-links-icon": "Services (grid icon in the header)",
        "sidebar": "Sidebar"
    },

    "topbar_variants": ["default"],
    "header_variants": ["classic", "centered", "minimal"],
    "footer_variants": ["columns", "compact"],

    "page_templates": ["default", "full-width", "with-sidebar", "landing"],
    "microsite_templates": ["standard"],

    "sections": {
        "hero": {
            "label": "DIU — Hero with video (heading = title, subheading = text)",
            "heading": "Beyond Classrooms, We Build Futures.",
            "subheading": "Study, create and connect on Bangladesh's most forward-thinking university grounds.",
            "fields": [
                { "key": "video", "type": "url", "label": "Video (MP4 link)", "default": "https://daffodilvarsity.edu.bd/hero.mp4" },
                { "key": "poster", "type": "image", "label": "Picture shown before / instead of the video" }
            ]
        },
        "mission": {
            "label": "DIU — Rankings, vision and mission",
            "source": "accreditation.recognition",
            "fields": [
                { "key": "headline", "type": "text", "label": "Headline", "default": "Shaping futures with a global vision - ranked among the world's best," },
                { "key": "highlight_prefix", "type": "text", "label": "Before the highlight", "default": "proudly" },
                { "key": "highlight", "type": "text", "label": "Highlight (yellow)", "default": "#1 in Bangladesh" },
                { "key": "button_label", "type": "text", "label": "Button text", "default": "Learn More" },
                { "key": "button_url", "type": "url", "label": "Button link", "default": "/rankings" },
                { "key": "vision_title", "type": "text", "label": "Vision title", "default": "Vision — Where We're Heading" },
                { "key": "vision_text", "type": "textarea", "label": "Vision", "default": "Becoming a globally recognized center of excellence through innovative, learner-centric, technology-driven education, and impactful research fostering a diverse, international academic community that actively shapes brighter future for all." },
                { "key": "mission_title", "type": "text", "label": "Mission title", "default": "Mission — What Drives Us" },
                { "key": "mission_points", "type": "repeater", "label": "Mission points", "fields": [{ "key": "text", "type": "text", "label": "Point" }],
                  "default": [
                      { "text": "Equip students for a rapidly changing world" },
                      { "text": "Foster a culture of innovation & internationalization" },
                      { "text": "Advance knowledge and sustainable development through research" },
                      { "text": "Empower graduates to lead positive change in society" },
                      { "text": "Forge strong industry-academia linkages for successful careers" }
                  ] },
                { "key": "quotes", "type": "repeater", "label": "Rotating quotes (**bold** for bold words)", "fields": [{ "key": "text", "type": "textarea", "label": "Quote" }],
                  "default": [
                      { "text": "Global **Top-20 in SDG 4, Top-40 in SDG8—**DIU turns vision into measurable impact." },
                      { "text": "**Pioneering excellence** in education and research for sustainable development goals." },
                      { "text": "**Leading innovation and transformation** in higher education across Bangladesh." }
                  ] }
            ]
        },
        "degree": {
            "label": "DIU — Find your degree (heading, subheading = line under it)",
            "heading": "Find Your Degree at DIU",
            "subheading": "38 programs • 6 faculties • Undergraduate & Graduate pathways",
            "fields": [
                { "key": "button_label", "type": "text", "label": "Link text", "default": "Browse our All Faculties" },
                { "key": "button_url", "type": "url", "label": "Link", "default": "/faculties" },
                { "key": "links", "type": "repeater", "label": "Big links", "max": 4, "fields": [{ "key": "label", "type": "text", "label": "Text" }, { "key": "url", "type": "url", "label": "Link" }],
                  "default": [
                      { "label": "Undergraduate Programs", "url": "/programs?level=undergraduate" },
                      { "label": "Post Graduate Programs", "url": "/programs?level=postgraduate" }
                  ] },
                { "key": "actions", "type": "repeater", "label": "Buttons", "max": 3, "fields": [{ "key": "label", "type": "text", "label": "Text" }, { "key": "url", "type": "url", "label": "Link" }],
                  "default": [
                      { "label": "Get Admission Info", "url": "/admission" },
                      { "label": "Experience Student Life", "url": "/campus-life" },
                      { "label": "Browse Institutes", "url": "/article/institutes" }
                  ] }
            ]
        },
        "scholarships": {
            "label": "DIU — Scholarships (heading, subheading = intro)",
            "heading": "Scholarships That Unlock Potential",
            "subheading": "Every dream deserves a chance—DIU's scholarship programs turn ambition into achievement.",
            "fields": [
                { "key": "link_label", "type": "text", "label": "Link text", "default": "Learn More About Scholarship" },
                { "key": "link_url", "type": "url", "label": "Link", "default": "/scholarship" },
                { "key": "youtube_id", "type": "text", "translatable": false, "label": "YouTube video id", "default": "RUoHuYIa2qQ" },
                { "key": "quote", "type": "text", "label": "Quote under the video", "default": "\"My DIU merit award let me create Bangladesh's first student AI start-up.\"" },
                { "key": "quote_author", "type": "text", "label": "Quote by", "default": "— Rahim, CSE '25" },
                { "key": "stat", "type": "text", "label": "Big figure", "default": "Up to 100%" },
                { "key": "stat_title", "type": "text", "label": "Under the figure", "default": "Tuition Coverage for Top Achievers & Eligible Students" },
                { "key": "stat_text", "type": "textarea", "label": "Text", "default": "With more than 25 categories, you’re likely to find a scholarship or waiver that fits your journey at DIU." },
                { "key": "button_label", "type": "text", "label": "Button text", "default": "Estimate your scholarship package" },
                { "key": "button_url", "type": "url", "label": "Button link", "default": "/tuition-fee-calculator" }
            ]
        },
        "research": {
            "label": "DIU — Research (heading, subheading = intro)",
            "heading": "Research & Innovation at DIU",
            "subheading": "From breakthrough discoveries to real-world impact—see how our scholars are shaping the future.",
            "fields": [
                { "key": "link_label", "type": "text", "label": "Link text", "default": "Partner with DIU Research" },
                { "key": "link_url", "type": "url", "label": "Link", "default": "https://research.daffodilvarsity.edu.bd/" },
                { "key": "stats", "type": "repeater", "label": "Figures", "max": 4, "fields": [{ "key": "number", "type": "number", "label": "Number" }, { "key": "suffix", "type": "text", "translatable": false, "label": "After the number" }, { "key": "label", "type": "text", "label": "Label" }],
                  "default": [
                      { "number": 5600, "suffix": "+", "label": "Peer Reviewed Paper" },
                      { "number": 120, "suffix": "+", "label": "Patents and IP Filings" },
                      { "number": 12, "suffix": "+", "label": "Research Centers" },
                      { "number": 500, "suffix": "+", "label": "PhD Scholars" }
                  ] },
                { "key": "stories", "type": "repeater", "label": "Impact stories", "max": 3, "fields": [{ "key": "image", "type": "image", "label": "Picture" }, { "key": "title", "type": "text", "label": "Title" }, { "key": "url", "type": "url", "label": "Link" }] },
                { "key": "partners_title", "type": "text", "label": "Partners title", "default": "Research & Innovation Partners" },
                { "key": "partners", "type": "repeater", "label": "Partner logos", "fields": [{ "key": "logo", "type": "image", "label": "Logo" }, { "key": "name", "type": "text", "label": "Name" }],
                  "default": [
                      { "logo": "images/partners/logo-2.png", "name": "Microsoft" },
                      { "logo": "images/partners/logo-3.webp", "name": "IEEE" },
                      { "logo": "images/partners/logo-4.webp", "name": "World Health Organization" },
                      { "logo": "images/partners/logo-5.png", "name": "Google" },
                      { "logo": "images/partners/logo-6.webp", "name": "AWS" },
                      { "logo": "images/partners/logo-1.webp", "name": "Nestle" }
                  ] },
                { "key": "partners_button_label", "type": "text", "label": "Button text", "default": "Explore Researches and Their Work" },
                { "key": "partners_button_url", "type": "url", "label": "Button link", "default": "https://research.daffodilvarsity.edu.bd/" }
            ]
        },
        "events": {
            "label": "DIU — Recent events",
            "source": "events.past",
            "fields": [
                { "key": "title_strong", "type": "text", "label": "Title, first word", "default": "Recent" },
                { "key": "title_light", "type": "text", "label": "Title, light part", "default": "Events" },
                { "key": "button_label", "type": "text", "label": "Button text", "default": "Explore All Events" },
                { "key": "button_url", "type": "url", "label": "Button link", "default": "/events" },
                { "key": "badge", "type": "text", "label": "Badge on the picture", "default": "Featured" }
            ]
        },
        "visitors": {
            "label": "DIU — Distinguished visitors, the chosen ones (heading, subheading = intro)",
            "heading": "Meet our distinguished Faculty Members from Global",
            "subheading": "Our faculty includes distinguished scholars, industry experts, and researchers from Bangladesh and across the globe—bringing global knowledge and local relevance into every classroom.",
            "source": "international.visitors",
            "fields": [
                { "key": "button_label", "type": "text", "label": "Button text", "default": "View All" },
                { "key": "button_url", "type": "url", "label": "Button link", "default": "/visitors" }
            ]
        },
        "testimonials": {
            "label": "DIU — Testimonials, the chosen ones (heading, subheading = intro)",
            "heading": "What People Say",
            "subheading": "Students, alumni, parents and partners — from Bangladesh and abroad — on their experience at Daffodil International University.",
            "source": "testimonials.list",
            "fields": [
                { "key": "button_label", "type": "text", "label": "Button text", "default": "View All" },
                { "key": "button_url", "type": "url", "label": "Button link", "default": "/testimonials" }
            ]
        },
        "alumni-news": {
            "label": "DIU — Alumni stories and news (heading, subheading = line under it)",
            "heading": "Alumni Stories & Achievements",
            "subheading": "55K+ graduates, 19 countries, one unstoppable network.",
            "source": "news.latest",
            "fields": [
                { "key": "stats", "type": "repeater", "label": "Figures", "max": 2, "fields": [{ "key": "number", "type": "number", "label": "Number" }, { "key": "suffix", "type": "text", "translatable": false, "label": "After the number" }, { "key": "label", "type": "text", "label": "Label" }],
                  "default": [
                      { "number": 55000, "suffix": "+", "label": "Proud Alumni" },
                      { "number": 19, "suffix": "+", "label": "Countries Represented" }
                  ] }
            ]
        },
        "page-hero": {
            "label": "DIU — Microsite hero (name, about and cover of the department / program / faculty shown)",
            "fields": [
                { "key": "show_about", "type": "toggle", "label": "Show the about text", "default": true },
                { "key": "about_right", "type": "toggle", "label": "About text on the right (faculty pages)", "default": false },
                { "key": "image", "type": "image", "label": "Picture when the microsite has no cover" }
            ]
        },
        "programs": {
            "label": "DIU — Program cards and quick links ({name}, {short}, {parent}, {base} are replaced)",
            "heading": "Explore Our Academic Programs",
            "source": "program.by-level",
            "fields": [
                { "key": "apply_label", "type": "text", "label": "Card link text", "default": "Apply Now" },
                { "key": "quick_links_title", "type": "text", "label": "Quick links title", "default": "Quick Links" },
                { "key": "quick_links", "type": "repeater", "label": "Quick links", "fields": [{ "key": "label", "type": "text", "label": "Text" }, { "key": "url", "type": "url", "label": "Link" }],
                  "default": [
                      { "label": "Admission Requirements", "url": "/admission" },
                      { "label": "Tuition Fees", "url": "/tuition-fees" },
                      { "label": "Transfer Credits", "url": "/article/credit-transfer" },
                      { "label": "Waiver & Scholarship", "url": "/scholarship" },
                      { "label": "Student Portal", "url": "https://studentportal.diu.edu.bd/" },
                      { "label": "e-Learn", "url": "https://elearn.daffodilvarsity.edu.bd/" },
                      { "label": "Library", "url": "https://library.daffodilvarsity.edu.bd/" }
                  ] }
            ]
        },
        "notices": {
            "label": "DIU — Notices on blue",
            "heading": "Academic Notices & Announcements",
            "subheading": "Each card links to full program details—including curriculum, admissions requirements, and faculty contacts.",
            "source": "notice.board",
            "fields": [
                { "key": "button_label", "type": "text", "label": "Button text", "default": "View All Notices" },
                { "key": "button_url", "type": "url", "label": "Button link", "default": "{base}/notices" }
            ]
        },
        "faculty-stats": {
            "label": "DIU — Faculty headline with four figures (the faculty's own counters; the figures below when it has none)",
            "heading": "Transforming Bangladesh's Tech Landscape, Empowering Global Innovators",
            "subheading": "Explore our BSc and MSc programs designed to drive local impact and lead on the world stage.",
            "source": "core.statistics",
            "fields": [
                { "key": "link_label", "type": "text", "label": "Link text", "default": "Browse All Faculty Members" },
                { "key": "link_url", "type": "url", "label": "Link", "default": "https://faculty.daffodilvarsity.edu.bd/" },
                { "key": "stats", "type": "repeater", "label": "Figures", "max": 4, "fields": [
                    { "key": "number", "type": "text", "label": "Figure (e.g. 120+)" },
                    { "key": "label", "type": "text", "label": "Label" }
                ], "default": [
                    { "number": "5600+", "label": "Publications by our faculty & students" },
                    { "number": "120+", "label": "Active industry partnerships" },
                    { "number": "12+", "label": "Research labs" },
                    { "number": "50+", "label": "PhD Scholarly Faculty" }
                ] }
            ]
        },
        "faculty-departments": {
            "label": "DIU — Departments of the faculty, quick links and the dean",
            "heading": "Department and Programs",
            "subheading": "Each card links to full program details—including curriculum, admissions requirements, and faculty contacts.",
            "source": "department.list",
            "fields": [
                { "key": "list_title", "type": "text", "label": "List title", "default": "Departments Name" },
                { "key": "dean_title", "type": "text", "label": "Dean title", "default": "Meet Our Dean" },
                { "key": "quick_links_title", "type": "text", "label": "Quick links title", "default": "Quick Links" },
                { "key": "quick_links", "type": "repeater", "label": "Quick links", "fields": [
                    { "key": "label", "type": "text", "label": "Text" },
                    { "key": "url", "type": "url", "label": "Link" }
                ], "default": [
                    { "label": "Admission Eligibility", "url": "/admission/faculty/{short}" },
                    { "label": "Transfer Credits", "url": "/article/credit-transfer" },
                    { "label": "Waiver & Scholarship", "url": "/scholarship" }
                ] }
            ]
        },
        "labs": {
            "label": "DIU — Labs (the microsite's labs; the cards below when it has none)",
            "heading": "Cutting-Edge Research & Labs",
            "subheading": "Research That Advances Technology",
            "source": "lab.list",
            "fields": [
                { "key": "cards", "type": "repeater", "label": "Cards when there are no labs", "fields": [{ "key": "image", "type": "image", "label": "Picture" }, { "key": "title", "type": "text", "label": "Title" }, { "key": "text", "type": "text", "label": "Text" }, { "key": "url", "type": "url", "label": "Link" }],
                  "default": [
                      { "image": "images/services/es-3.webp", "title": "Transport Service", "text": "25 AC buses covering Dhaka & nearby districts.", "url": "/transport" },
                      { "image": "images/services/es-4.webp", "title": "Hostel Facility", "text": "Safe, Smart residences five minutes from class.", "url": "https://hall.daffodilvarsity.edu.bd/" },
                      { "image": "images/services/es-2.webp", "title": "Scholarships & Waivers", "text": "Merit grants up to 100% + need-based aid calculator.", "url": "/scholarship" },
                      { "image": "images/services/es-1.webp", "title": "Student Life", "text": "60+ clubs, festivals, sports & volunteering.", "url": "/campus-life" }
                  ] }
            ]
        },
        "campus-services": {
            "label": "DIU — Essential campus services (cards)",
            "heading": "Essential Campus Services",
            "subheading": "Quick links to hostels, buses, financial aid, and activities—because study is only part of the story.",
            "fields": [
                { "key": "cards", "type": "repeater", "label": "Cards", "fields": [{ "key": "image", "type": "image", "label": "Picture" }, { "key": "title", "type": "text", "label": "Title" }, { "key": "text", "type": "text", "label": "Text" }, { "key": "url", "type": "url", "label": "Link" }],
                  "default": [
                      { "image": "images/services/es-3.webp", "title": "Transport Service", "text": "25 AC buses covering Dhaka & nearby districts.", "url": "/transport" },
                      { "image": "images/services/es-4.webp", "title": "Hostel Facility", "text": "Safe, Smart residences five minutes from class.", "url": "https://hall.daffodilvarsity.edu.bd/" },
                      { "image": "images/services/es-2.webp", "title": "Scholarships & Waivers", "text": "Merit grants up to 100% + need-based aid calculator.", "url": "/scholarship" },
                      { "image": "images/services/es-1.webp", "title": "Student Life", "text": "60+ clubs, festivals, sports & volunteering.", "url": "/campus-life" }
                  ] }
            ]
        },
        "partners": {
            "label": "DIU — Partner logos",
            "fields": [
                { "key": "grey", "type": "toggle", "label": "Grey band (department pages)", "default": true },
                { "key": "space_below", "type": "toggle", "label": "Space below (faculty pages)", "default": false },
                { "key": "partners_title", "type": "text", "label": "Title", "default": "Research & Innovation Partners" },
                { "key": "partners", "type": "repeater", "label": "Partner logos", "fields": [{ "key": "logo", "type": "image", "label": "Logo" }, { "key": "name", "type": "text", "label": "Name" }],
                  "default": [
                      { "logo": "images/partners/logo-1.webp", "name": "Nestle" },
                      { "logo": "images/partners/logo-2.png", "name": "Microsoft" },
                      { "logo": "images/partners/logo-3.webp", "name": "IEEE" },
                      { "logo": "images/partners/logo-4.webp", "name": "World Health Organization" },
                      { "logo": "images/partners/logo-5.png", "name": "Google" },
                      { "logo": "images/partners/logo-6.webp", "name": "AWS" }
                  ] },
                { "key": "partners_button_label", "type": "text", "label": "Button text", "default": "Explore Researches and Their Work" },
                { "key": "partners_button_url", "type": "url", "label": "Button link", "default": "https://research.daffodilvarsity.edu.bd/" }
            ]
        },
        "ambitions": {
            "label": "DIU — Scholarships with alumni stories (the microsite's pride alumni)",
            "heading": "Big Ambitions?|We'll Cover the Cost.",
            "source": "alumni.pride",
            "fields": [
                { "key": "text", "type": "textarea", "label": "Text (| = line break)", "default": "Cut your costs, not your ambitions.|Over 60% of DIU students qualify for a|scholarship or waiver—some up to 100%. Check|your savings in a minute and join them today." },
                { "key": "links", "type": "repeater", "label": "Links", "max": 3, "fields": [{ "key": "label", "type": "text", "label": "Text" }, { "key": "url", "type": "url", "label": "Link" }],
                  "default": [
                      { "label": "Apply for Aid", "url": "/scholarship" },
                      { "label": "Estimate My Waiver", "url": "/tuition-fee-calculator" }
                  ] }
            ]
        },
        "microsite-news": {
            "label": "DIU — News of the microsite ({name}, {short}, {parent} are replaced)",
            "heading": "{parent} News",
            "subheading": "From hands-on workshops to breakthrough announcements—never miss what's shaping tomorrow's innovations .",
            "source": "news.latest",
            "fields": []
        },
        "event-cards": {
            "label": "DIU — Upcoming events as cards ({name}, {short}, {parent} are replaced)",
            "heading": "{parent} Events",
            "subheading": "From hands-on workshops to breakthrough announcements—never miss what's shaping tomorrow's innovations at {short}.",
            "source": "events.upcoming",
            "fields": [
                { "key": "link_label", "type": "text", "label": "Link text", "default": "View All Events" },
                { "key": "link_url", "type": "url", "label": "Link", "default": "{base}/events" },
                { "key": "card_link", "type": "text", "label": "Card link text", "default": "View Details" }
            ]
        },
        "link-button": {
            "label": "DIU — Centred button (\"Stay Connected!\")",
            "fields": [
                { "key": "strong", "type": "text", "label": "Bold part", "default": "Stay Connected!" },
                { "key": "text", "type": "text", "label": "Rest", "default": "Join the alumni portal" },
                { "key": "url", "type": "url", "label": "Link", "default": "https://alumni.daffodilvarsity.edu.bd/" }
            ]
        }
    },

    "fonts": ["Manrope", "Hind Siliguri", "Mina"],
    "tokens": {
        "color-primary": "#034EA2",
        "color-secondary": "#002652",
        "color-accent": "#39B54A",
        "color-surface": "#F3F4F9",
        "font-heading": "Manrope",
        "font-body": "Manrope",
        "font-bn": "Hind Siliguri"
    },

    "options": [
        { "key": "sticky_header", "type": "toggle", "label": "Header stays on top while scrolling", "default": true },
        { "key": "hero_height", "type": "select", "label": "Hero height", "options": ["medium", "tall"], "default": "tall" },
        { "key": "header_cta_url", "type": "text", "label": "Apply button link (empty = no button)", "default": "https://admission.daffodilvarsity.edu.bd/" },
        { "key": "header_cta_label", "type": "text", "label": "Apply button text (empty = Apply Now)", "default": "" },
        { "key": "page_hero_image", "type": "image", "label": "Pages: picture behind the title (a page's own featured picture wins; empty = DIU's)" },
        { "key": "programs_faculty", "type": "text", "label": "Programs page: faculty shown first (short name; empty = the first)", "default": "fbe" },
        { "key": "footer_band_1_label", "type": "text", "label": "Footer band, left link text (empty = no band)", "default": "Campus Life in 60 Seconds" },
        { "key": "footer_band_1_url", "type": "text", "label": "Footer band, left link", "default": "https://annisulhuq.daffodil.university/vt/" },
        { "key": "footer_band_2_label", "type": "text", "label": "Footer band, right link text", "default": "Get a Virtual Tour" },
        { "key": "footer_band_2_url", "type": "text", "label": "Footer band, right link", "default": "https://annisulhuq.daffodil.university/vt/" },
        { "key": "footer_cta_title", "type": "text", "label": "Footer call-to-action title (empty = none; | = line break)", "default": "Start Your Journey|with Us" },
