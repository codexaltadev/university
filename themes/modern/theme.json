{
    "slug": "modern",
    "name": "University Modern",
    "version": "1.1.0",
    "requires_core": "^1.0",
    "author": {
        "name": "UWMS",
        "email": ""
    },
    "license": "proprietary",
    "description": "A bold, photographic theme for any university: royal blue, midnight navy and gold, full-width picture heroes, strong admission calls. Logo, colours and every text come from Admin.",
    "screenshot": "screenshot.png",
    "layouts": {},
    "menu_locations": {
        "primary": "Primary (header)",
        "topbar": "Utility links (above the header)",
        "footer-1": "Footer column 1",
        "footer-2": "Footer column 2",
        "footer-3": "Footer column 3",
        "sidebar": "Sidebar"
    },
    "header_variants": [
        "modern",
        "minimal"
    ],
    "footer_variants": [
        "columns",
        "simple"
    ],
    "page_templates": [
        "default",
        "full-width",
        "with-sidebar",
        "right-sidebar",
        "landing"
    ],
    "microsite_templates": [
        "standard"
    ],
    "sections": {
        "hero": {
            "label": "Modern — Hero: full-width picture (or brand colours), heading, text, two buttons (heading / subheading = the builder's)",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "First button text"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "First button link"
                },
                {
                    "key": "button2_label",
                    "type": "text",
                    "label": "Second button text"
                },
                {
                    "key": "button2_url",
                    "type": "url",
                    "label": "Second button link"
                },
                {
                    "key": "image",
                    "type": "image",
                    "label": "Picture behind the heading (empty = brand colours)"
                }
            ]
        },
        "program-finder": {
            "label": "Modern — Program finder: a search box and level shortcuts (heading = the builder's)",
            "fields": [
                {
                    "key": "placeholder",
                    "type": "text",
                    "label": "Text in the search box (empty = Search programs)"
                },
                {
                    "key": "action_url",
                    "type": "url",
                    "label": "Program listing address the search goes to",
                    "default": "{base}/programs"
                },
                {
                    "key": "links",
                    "type": "repeater",
                    "label": "Shortcuts beside the search (levels, faculties …)",
                    "max": 6,
                    "fields": [
                        {
                            "key": "label",
                            "type": "text",
                            "label": "Text"
                        },
                        {
                            "key": "url",
                            "type": "url",
                            "label": "Link"
                        }
                    ]
                }
            ]
        },
        "notices": {
            "label": "Modern — Notice board: the latest notices with dates",
            "source": "notice.board",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "\"View all\" button text (empty = View all)"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "\"View all\" button link (empty = the module's own page)",
                    "default": "{base}/notices"
                }
            ]
        },
        "events": {
            "label": "Modern — Upcoming events as date cards",
            "source": "events.upcoming",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "\"View all\" button text (empty = View all)"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "\"View all\" button link (empty = the module's own page)",
                    "default": "{base}/events"
                }
            ]
        },
        "news": {
            "label": "Modern — News cards with pictures",
            "source": "news.latest",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "\"View all\" button text (empty = View all)"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "\"View all\" button link (empty = the module's own page)",
                    "default": "{base}/news"
                }
            ]
        },
        "faculties": {
            "label": "Modern — Faculties as tiles",
            "source": "faculty.list",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "\"View all\" button text (empty = View all)"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "\"View all\" button link (empty = the module's own page)",
                    "default": "/faculties"
                }
            ]
        },
        "programs": {
            "label": "Modern — Featured programs as cards",
            "source": "program.featured",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "\"View all\" button text (empty = View all)"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "\"View all\" button link (empty = the module's own page)",
                    "default": "{base}/programs"
                }
            ]
        },
        "stats": {
            "label": "Modern — Figures (a statistics set of the place)",
            "source": "core.statistics",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                }
            ]
        },
        "achievements": {
            "label": "Modern — Rankings and achievements as cards",
            "source": "achievements.recent",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "\"View all\" button text (empty = View all)"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "\"View all\" button link (empty = the module's own page)",
                    "default": "{base}/achievements"
                }
            ]
        },
        "admission-cta": {
            "label": "Modern — Call to action band (admission, fees …; heading / subheading = the builder's)",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "First button text"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "First button link"
                },
                {
                    "key": "button2_label",
                    "type": "text",
                    "label": "Second button text"
                },
                {
                    "key": "button2_url",
                    "type": "url",
                    "label": "Second button link"
                }
            ]
        },
        "testimonials": {
            "label": "Modern — Testimonials as quote cards",
            "source": "testimonials.list",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "\"View all\" button text (empty = View all)"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "\"View all\" button link (empty = the module's own page)",
                    "default": "{base}/testimonials"
                }
            ]
        },
        "gallery": {
            "label": "Modern — Photo gallery as a mosaic",
            "source": "gallery.photos",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "\"View all\" button text (empty = View all)"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "\"View all\" button link (empty = the module's own page)",
                    "default": "{base}/gallery"
                }
            ]
        },
        "partners": {
            "label": "Modern — Partner and recognition logos",
            "source": "partners.list",
            "fields": [
                {
                    "key": "eyebrow",
                    "type": "text",
                    "label": "Small line above the heading (empty = none)"
                },
                {
                    "key": "button_label",
                    "type": "text",
                    "label": "\"View all\" button text (empty = View all)"
                },
                {
                    "key": "button_url",
                    "type": "url",
                    "label": "\"View all\" button link (empty = the module's own page)",
                    "default": ""
                }
            ]
        }
    },
    "fonts": [
        "Plus Jakarta Sans",
        "Inter",
        "Noto Sans Bengali"
    ],
    "editor_css": [
        "css/editor.css"
    ],
    "tokens": {
        "color-primary": "#163C9E",
        "color-secondary": "#0B1B3F",
        "color-accent": "#F5B700",
        "color-bg": "#FFFFFF",
        "color-surface": "#F3F5FA",
        "color-text": "#0F172A",
        "color-text-muted": "#475569",
        "color-border": "#E2E8F0",
        "color-success": "#15803D",
        "color-warning": "#B45309",
        "color-danger": "#B91C1C",
        "font-heading": "Plus Jakarta Sans",
        "font-body": "Inter",
        "font-bn": "Noto Sans Bengali",
        "line-height-body": "1.65",
        "line-height-body-bn": "1.85",
        "radius-sm": "10px",
        "radius-md": "14px",
        "radius-lg": "24px",
        "container-max": "1240px",
        "shadow-card": "0 1px 2px rgba(11, 27, 63, .05), 0 12px 32px -16px rgba(11, 27, 63, .18)"
    },
    "options": [
        {
            "key": "sticky_header",
            "type": "toggle",
            "label": "Header stays on top while scrolling",
            "default": true
        },
        {
            "key": "header_cta_label",
            "type": "text",
            "label": "Header button text (empty = no button)",
            "default": ""
        },
        {
            "key": "header_cta_url",
            "type": "text",
            "label": "Header button link",
            "default": ""
        },
        {
            "key": "footer_tagline",
            "type": "text",
            "label": "Footer text under the logo (empty = the site tagline)",
            "default": ""
        },
        {
            "key": "animations",
            "type": "toggle",
            "label": "Sections fade in while scrolling",
            "default": true
        }
    ]
}
